import {
  STATUS_CLASSES,
  fmtCurrency,
  fmtPct,
  fmtDate,
  fmtDateTime,
} from "./helpers.mjs";

<html lang="en">
  <head>
    <title>Customer Data Table</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
  </head>
  <body class="bg-gray-50 text-gray-900">
    <header class="px-6 py-4 border-b">
      <h1 class="text-xl font-semibold">Customer Accounts</h1>
      <p class="text-sm text-gray-600">Live revenue and account status across all regions.</p>
    </header>
    <main class="p-6">
      <table class="min-w-full text-sm border-collapse">
        <thead class="bg-gray-100">
          <tr>
            <th class="px-3 py-2 text-left">ID</th>
            <th class="px-3 py-2 text-left">Name</th>
            <th class="px-3 py-2 text-left">Email</th>
            <th class="px-3 py-2 text-left">Status</th>
            <th class="px-3 py-2 text-right">Amount</th>
            <th class="px-3 py-2 text-right">Tax</th>
            <th class="px-3 py-2 text-right">Total</th>
            <th class="px-3 py-2 text-left">Created</th>
            <th class="px-3 py-2 text-left">Updated</th>
            <th class="px-3 py-2 text-right">Score</th>
            <th class="px-3 py-2 text-left">Country</th>
            <th class="px-3 py-2 text-left">Tags</th>
          </tr>
        </thead>
        <tbody>
          <for|row, idx| of=input.rows>
            <tr class=(idx % 2 === 0 ? "bg-white" : "bg-gray-50") data-row-id=row.id>
              <td class="px-3 py-2 font-mono text-gray-500">${row.id}</td>
              <td class="px-3 py-2">${row.name}</td>
              <td class="px-3 py-2 text-blue-700">${row.email}</td>
              <td class="px-3 py-2">
                <span class=STATUS_CLASSES[row.status]>${row.status}</span>
              </td>
              <td class="px-3 py-2 text-right font-mono">${fmtCurrency(row.amountCents)}</td>
              <td class="px-3 py-2 text-right font-mono text-gray-500">${fmtCurrency(row.taxCents)}</td>
              <td class="px-3 py-2 text-right font-mono font-semibold">${fmtCurrency(row.amountCents + row.taxCents)}</td>
              <td class="px-3 py-2 text-gray-600">${fmtDate(row.createdUnix)}</td>
              <td class="px-3 py-2 text-gray-600">${fmtDateTime(row.updatedUnix)}</td>
              <td class="px-3 py-2 text-right font-mono">${fmtPct(row.scoreBps)}</td>
              <td class="px-3 py-2">${row.country}</td>
              <td class="px-3 py-2">
                <for|tag| of=row.tags>
                  <span class="inline-block px-2 py-0.5 mr-1 rounded text-xs bg-blue-50 text-blue-700 border border-blue-200">${tag}</span>
                </for>
              </td>
            </tr>
          </for>
        </tbody>
      </table>
    </main>
  </body>
</html>
