<main class="mx-auto w-full max-w-6xl px-4 py-10">
  <h1 class="text-2xl font-bold tracking-tight">All products</h1>
  <div class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
    <% @products.each do |product| %>
      <a href="/products/<%= product[:id] %>" class="group flex flex-col rounded-xl border border-slate-200 bg-white p-4 shadow-sm transition hover:shadow-md">
        <div class="mb-4 flex h-32 items-center justify-center rounded-lg bg-slate-100 text-3xl font-bold text-slate-300"><%= product[:category] %></div>
        <p class="text-xs font-medium uppercase tracking-wide text-slate-400"><%= product[:category] %></p>
        <h3 class="mt-1 text-sm font-semibold text-slate-900 group-hover:text-indigo-600"><%= product[:name] %></h3>
        <div class="mt-2 flex items-center gap-1">
          <div class="flex">
            <% filled = (product[:rating_tenths] + 5) / 10 %>
            <% 5.times do |index| %><svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="<%= index < filled ? 'h-4 w-4 text-amber-400' : 'h-4 w-4 text-slate-200' %>"><path d="<%= star_path %>"></path></svg><% end %>
          </div>
          <span class="text-xs text-slate-500"><%= format_rating(product[:rating_tenths]) %> (<%= product[:review_count] %>)</span>
        </div>
        <p class="mt-3 text-lg font-bold"><%= format_price(product[:price_cents]) %></p>
      </a>
    <% end %>
  </div>
</main>
