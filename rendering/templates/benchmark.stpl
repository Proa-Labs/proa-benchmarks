<html lang="en">
<head>
    <title>SSR Benchmark Page</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body>
    <header class="hero-section">
        <h1 class="title">SSR Framework Benchmark</h1>
        <p class="subtitle">Comparing Proa, Leptos, Dioxus, and Yew</p>
    </header>
    <main class="main-content">
        <% for section_idx in 0..self.num_sections { %>
        <section class="card-section" data-section="<%= if section_idx % 2 == 0 { "even" } else { "odd" } %>">
            <h2 class="section-title"><%= match section_idx {
                0 => "Performance Metrics",
                1 => "Rendering Speed",
                2 => "Memory Efficiency",
                _ => "Framework Comparison",
            } %></h2>
            <div class="card-grid">
                <% for card_idx in 0..self.cards_per_section { %>
                <article class="card" data-card-id="<%= if card_idx % 2 == 0 { "even" } else { "odd" } %>">
                    <div class="card-header">
                        <img src="/images/benchmark.png" alt="Benchmark chart" class="card-image">
                    </div>
                    <div class="card-body">
                        <h3 class="card-title"><%= match card_idx % 4 {
                            0 => "Latency Analysis",
                            1 => "Throughput Metrics",
                            2 => "Memory Usage",
                            _ => "CPU Utilization",
                        } %></h3>
                        <p class="card-description">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
                        <ul class="feature-list">
                            <% for item_idx in 0..self.items_per_card { %>
                            <li class="feature-item"><%= match item_idx {
                                0 => "Sub-millisecond response times",
                                1 => "Zero-copy rendering pipeline",
                                2 => "SIMD-accelerated escaping",
                                3 => "Pre-allocated buffers",
                                _ => "Minimal heap allocations",
                            } %></li>
                            <% } %>
                        </ul>
                        <button class="btn-primary" type="button">View Details</button>
                    </div>
                </article>
                <% } %>
            </div>
        </section>
        <% } %>
    </main>
    <footer class="footer">
        <p>Rendered by the SSR benchmark fixture</p>
    </footer>
</body>
</html>
